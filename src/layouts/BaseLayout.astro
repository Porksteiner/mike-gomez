---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
  jsonld?: unknown;
}
const {
  title = 'Mike Gomez — Systems engineer. Software, apps, private AI, and websites.',
  description = 'Mike Gomez designs, builds, and ships software, mobile apps, private AI systems, and websites for businesses that need them to work.',
  image,
  type,
  jsonld,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <Seo title={title} description={description} image={image} type={type} jsonld={jsonld} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = document.querySelectorAll('.reveal');
        var vids = document.querySelectorAll('video[data-inview]');
        if (!('IntersectionObserver' in window)) {
          items.forEach(function (el) { el.classList.add('is-in'); });
          vids.forEach(function (v) { v.controls = true; });
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { rootMargin: '0px 0px -8% 0px' });
        items.forEach(function (el) { io.observe(el); });
        // Safety net: never leave content hidden.
        setTimeout(function () { items.forEach(function (el) { el.classList.add('is-in'); }); }, 3500);

        // Videos load and play only while on screen; reduced motion gets controls instead.
        if (reduce) { vids.forEach(function (v) { v.controls = true; }); return; }
        var vio = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            var v = e.target;
            if (e.isIntersecting) { var p = v.play(); if (p && p.catch) p.catch(function () { v.controls = true; }); }
            else { v.pause(); }
          });
        }, { threshold: 0.35 });
        vids.forEach(function (v) { vio.observe(v); });
      })();
    </script>
  </body>
</html>
