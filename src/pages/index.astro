---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/settings.json';

const disciplines = [
  { n: '01', name: 'Software', note: 'Desktop tools that run offline and keep records straight.' },
  { n: '02', name: 'Mobile apps', note: 'Designed, built, and shipped to the App Store.' },
  { n: '03', name: 'Private AI', note: 'Assistants that run on your own machine, not someone else’s cloud.' },
  { n: '04', name: 'Websites', note: 'Fast, clear sites for businesses that need customers to call.' },
];

const more = [
  {
    group: 'Software',
    items: [
      { name: 'Helm', kind: 'AI operations dashboard', status: 'In daily use', desc: 'A desktop command center that hands approved tasks to a crew of AI agents and reports back, including over Telegram.', stack: 'Electron · Node · Three.js' },
      { name: 'WISP Builder', kind: 'Compliance tool', status: 'Complete', img: '/media/wisp.jpg', desc: 'Answers a tax preparer’s plain-English questions and writes their required security plan. Runs offline in a single file.', stack: 'HTML · JavaScript' },
    ],
  },
  {
    group: 'Websites',
    items: [
      { name: 'BaitIQ website', kind: 'Product site · baitiq.dev', status: 'Live', img: '/media/baitiq-site.jpg', href: 'https://baitiq.dev', desc: 'The marketing site for BaitIQ: what the app does, pricing, and a fishing blog built to be found on Google.', stack: 'Astro · Vercel' },
      { name: 'Credit Habit Academy', kind: 'Credit education', status: 'Client · in progress', img: '/media/credit.jpg', desc: 'Brand and booking site for a credit education practice, with scheduling and payment built in.', stack: 'Astro · Stripe' },
    ],
  },
  {
    group: 'Concepts',
    note: 'Designs I made on my own for local businesses. They are not clients.',
    items: [
      { name: 'Dinosaur Tattoo Company', kind: 'Tattoo studio · Dothan, AL', status: 'Concept · not a client', concept: true, img: '/media/concept-dino.jpg', desc: 'Tap an artist, see that artist\u2019s work, and book with them directly.', stack: 'HTML · CSS' },
      { name: 'S&A Hair Co.', kind: 'Salon · Dothan, AL', status: 'Concept · not a client', concept: true, img: '/media/concept-sahair.jpg', desc: 'Every chair gets its own page: the stylist, her work, and her booking link.', stack: 'HTML · CSS' },
      { name: 'Vittles Cafe', kind: 'Diner · Ozark, AL', status: 'Concept · not a client', concept: true, img: '/media/concept-vittles.jpg', desc: 'A menu-first site for a country diner, with call-to-order and directions up top.', stack: 'HTML · CSS' },
    ],
  },
];

const steps = [
  { t: 'A call', d: 'Thirty minutes on what you need and whether I’m the right person for it. If I’m not, I’ll say so.' },
  { t: 'A fixed price', d: 'A written scope, timeline, and price within a day. No hourly meter.' },
  { t: 'Working software early', d: 'You see something real inside the first week, and regular updates after.' },
  { t: 'Launch and support', d: 'I ship it, walk you through it, and stay on for thirty days. You own the code.' },
];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: settings.name,
  url: 'https://mikegomez.dev',
  email: settings.email,
  jobTitle: 'Systems Engineer',
  address: { '@type': 'PostalAddress', addressRegion: 'Alabama', addressCountry: 'US' },
  sameAs: ['https://apps.apple.com/us/app/baitiq/id6768169415'],
};
---
<BaseLayout jsonld={jsonld}>
  <!-- HERO -->
  <section class="hero">
    <div class="shell">
      <p class="label label--gold">Systems engineer · Alabama</p>
      <h1>I build what the business <em class="gold">actually needs.</em></h1>
      <p class="lead hero-lead">Software, mobile apps, private AI, and websites. One engineer who designs it, builds it, secures it, and ships it.</p>
      <div class="hero-cta">
        <a href={settings.calendly} target="_blank" rel="noopener noreferrer" class="btn btn--primary">Book a 30-minute call</a>
        <a href="#work" class="btn btn--ghost">See the work</a>
      </div>
      <ul class="disc">
        {disciplines.map((d) => (
          <li>
            <span class="label label--gold">{d.n}</span>
            <h2>{d.name}</h2>
            <p>{d.note}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FEATURED: FALKRYN -->
  <section id="work" class="rule feat">
    <div class="shell">
      <header class="feat-head reveal">
        <p class="label">Featured · Software</p>
        <h2>FALKRYN</h2>
        <p class="lead">A flight logbook for drone teams that has to work with no internet and hold up as a record.</p>
      </header>

      <figure class="screen reveal">
        <div class="screen-bar"><i></i><i></i><i></i><span class="label">FALKRYN · desktop</span></div>
        <video data-inview muted loop playsinline preload="none" poster="/media/falkryn.jpg" width="1280" height="800"
          aria-label="Screens from FALKRYN: live drone tracking, a flight replayed over aerial imagery, fleet readiness, and the evidence ledger">
          <source src="/media/falkryn.webm" type="video/webm" />
          <source src="/media/falkryn.mp4" type="video/mp4" />
        </video>
        <figcaption class="label">Screens from the working build</figcaption>
      </figure>

      <div class="feat-body">
        <div class="reveal">
          <p>Police and agriculture drone units need to prove what flew, where, and who was at the controls. FALKRYN keeps aircraft, batteries, pilots, and every flight in one place on the team’s own computer.</p>
          <p class="feat-status"><span class="dot"></span>Version 0.2 · Windows · team portal live</p>
        </div>
        <ul class="facts reveal">
          <li><strong>Live tracking.</strong> Watches aircraft in the air on a 3D map, receive-only.</li>
          <li><strong>Flight replay.</strong> Imports flight logs and replays them over the team’s own maps.</li>
          <li><strong>Tamper-evident ledger.</strong> Every change is signed and chained, so edits can’t be hidden.</li>
          <li><strong>Works offline.</strong> Encrypted on disk, with maps stored locally for the field.</li>
        </ul>
        <p class="label stack reveal">Rust · Tauri · React · SQLite · Postgres</p>
      </div>
    </div>
  </section>

  <!-- FEATURED: BAITIQ -->
  <section class="rule feat feat--phone">
    <div class="shell phone-grid">
      <figure class="phone reveal">
        <video data-inview muted loop playsinline preload="none" poster="/media/baitiq-scan.jpg" width="480" height="1044"
          aria-label="BaitIQ on an iPhone: a photo of a pond is analysed and three ranked bait recommendations appear">
          <source src="/media/baitiq-scan.webm" type="video/webm" />
          <source src="/media/baitiq-scan.mp4" type="video/mp4" />
        </video>
        <figcaption class="label">Recorded on an iPhone</figcaption>
      </figure>

      <div>
        <header class="feat-head reveal">
          <p class="label">Featured · Mobile app</p>
          <h2>BaitIQ</h2>
          <p class="lead">Point your phone at the water. It tells you what to throw and where to cast.</p>
        </header>
        <div class="reveal">
          <p>An AI fishing companion I designed, built, and shipped on my own. It is live on the App Store with subscriptions, accounts, and a social side.</p>
          <p class="feat-status"><span class="dot"></span>Live on the App Store</p>
        </div>
        <ul class="facts reveal">
          <li><strong>AI spot analysis.</strong> One photo becomes ranked bait picks, casting zones, and a confidence score.</li>
          <li><strong>Bite score.</strong> Weather, moon phase, and pressure combined into one number for today.</li>
          <li><strong>Catch log and crews.</strong> Logged catches, friends, and a leaderboard.</li>
        </ul>
        <p class="label stack reveal">React Native · Expo · Supabase · GPT-4o</p>
        <p class="reveal"><a class="link" href="https://apps.apple.com/us/app/baitiq/id6768169415" target="_blank" rel="noopener noreferrer">View on the App Store</a></p>
      </div>
    </div>
  </section>

  <!-- PRIVATE AI -->
  <section class="rule ai">
    <div class="shell ai-grid">
      <div class="reveal">
        <p class="label">Service · Private AI</p>
        <h2>AI that never leaves <em class="gold">your office.</em></h2>
        <p class="lead">For law firms and other offices that can’t paste client files into a public chatbot.</p>
        <p class="muted">I build and install an assistant that runs on a machine you own. It drafts, summarizes, and answers questions from your own documents. Nothing is sent to an outside AI company.</p>
        <a href="/private-ai/" class="btn btn--ghost">How it works and what it costs</a>
      </div>
      <a href="/private-ai/" class="ai-shot reveal" aria-label="Open the Private AI page">
        <img src="/media/privateai.jpg" alt="The Private AI offer page" loading="lazy" width="1200" height="750" />
      </a>
    </div>
  </section>

  <!-- MORE WORK -->
  <section class="rule more">
    <div class="shell">
      <header class="reveal">
        <p class="label">More work</p>
        <h2>Different problems. Same standard.</h2>
      </header>
      {more.map((g) => (
        <div class="group">
          <h3 class="label label--gold group-name">{g.group}</h3>
          {g.note && <p class="group-note">{g.note}</p>}
          <ul class="ledger">
            {g.items.map((it) => (
              <li class="row reveal">
                <div class="row-thumb">
                  {it.concept && <span class="concept-stamp">Concept</span>}
                  {it.img
                    ? <img src={it.img} alt={`${it.name} screenshot`} loading="lazy" width="1200" height="750" />
                    : <span class="mono-mark" aria-hidden="true">{it.name.slice(0, 1)}</span>}
                </div>
                <div class="row-main">
                  <h4>{it.href ? <a class="row-link" href={it.href} target="_blank" rel="noopener noreferrer">{it.name}</a> : it.name}</h4>
                  <p class="row-kind">{it.kind}</p>
                  <p class="row-desc">{it.desc}</p>
                </div>
                <div class="row-meta">
                  <span class="label">{it.status}</span>
                  <span class="label">{it.stack}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="rule about">
    <div class="shell about-grid">
      <div class="reveal">
        <p class="label">About</p>
        <h2>One person, start to finish.</h2>
      </div>
      <div class="reveal">
        <p class="lead">I’m Mike. I manage systems and networks for a living, and I build software because the tools I needed didn’t exist.</p>
        <p class="muted">That mix is the point. The person designing your app also knows how it gets secured, hosted, and kept running. You talk to me, I build it, and I’m the one who answers when something needs attention.</p>
        <ol class="steps">
          {steps.map((s, i) => (
            <li>
              <span class="label label--gold">0{i + 1}</span>
              <div><h3>{s.t}</h3><p>{s.d}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="rule contact">
    <div class="shell contact-inner reveal">
      <p class="label label--gold">Contact</p>
      <h2>Tell me what you need built.</h2>
      <p class="lead">An idea, a broken process, or a full spec. I reply within one business day.</p>
      <div class="hero-cta">
        <a href={settings.calendly} target="_blank" rel="noopener noreferrer" class="btn btn--primary">Book a 30-minute call</a>
        <a href={`mailto:${settings.email}`} class="btn btn--ghost">{settings.email}</a>
      </div>
      <p class="muted fineprint">Most projects run $3k–$20k, quoted as a fixed price before work starts.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero { padding-block: clamp(4rem, 10vw, 8.5rem) clamp(3.5rem, 7vw, 6rem); }
  .hero h1 { font-size: clamp(2.6rem, 1.2rem + 6.4vw, 6rem); max-width: 14ch; margin-top: 1.25rem; font-weight: 350; }
  .hero-lead { max-width: 44ch; margin-top: 1.75rem; }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .disc { display: grid; gap: 0; margin-top: clamp(3.5rem, 7vw, 6rem); border-top: 1px solid var(--line); }
  .disc li { padding: 1.5rem 0; border-bottom: 1px solid var(--line); }
  .disc h2 { font-size: 1.45rem; margin-top: 0.6rem; }
  .disc p { color: var(--ink-2); font-size: 0.95rem; margin-top: 0.5rem; max-width: 30ch; }
  @media (min-width: 640px) {
    .disc { grid-template-columns: repeat(2, 1fr); }
    .disc li { padding: 1.75rem 1.5rem 1.75rem 0; }
  }
  @media (min-width: 1000px) {
    .disc { grid-template-columns: repeat(4, 1fr); }
    .disc li { border-bottom: 0; border-right: 1px solid var(--line); padding: 1.75rem 1.5rem 0.5rem; }
    .disc li:first-child { padding-left: 0; }
    .disc li:last-child { border-right: 0; }
  }

  /* SHARED SECTION TYPE */
  section h2 { font-size: clamp(2rem, 1.3rem + 3vw, 3.6rem); margin-top: 0.9rem; }
  .feat-head .lead, .ai .lead { max-width: 40ch; margin-top: 1rem; }

  /* FEATURED */
  .feat-head h2 { font-size: clamp(2.6rem, 1.4rem + 5vw, 5rem); }
  .screen { margin-top: clamp(2rem, 4vw, 3.25rem); border: 1px solid var(--line-2); border-radius: var(--radius); overflow: hidden; background: #070807; }
  .screen-bar { display: flex; align-items: center; gap: 6px; padding: 0.6rem 0.9rem; border-bottom: 1px solid var(--line); background: var(--card); }
  .screen-bar i { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
  .screen-bar .label { margin-left: 0.6rem; }
  .screen video { width: 100%; aspect-ratio: 1280 / 800; object-fit: cover; }
  .screen figcaption { padding: 0.7rem 0.9rem; border-top: 1px solid var(--line); background: var(--card); }

  .feat-body { display: grid; gap: 1.75rem; margin-top: clamp(2rem, 4vw, 3rem); }
  .feat-body p, .phone-grid p { color: var(--ink-2); max-width: 52ch; }
  .feat-status { display: flex; align-items: center; gap: 0.6rem; margin-top: 1.1rem; font-size: 0.92rem; color: var(--ink) !important; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--gold); flex: none; }
  .facts { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .facts li { padding: 0.9rem 0; border-bottom: 1px solid var(--line); color: var(--ink-2); font-size: 0.97rem; }
  .facts strong { color: var(--ink); font-weight: 500; }
  .stack { grid-column: 1 / -1; }
  @media (min-width: 900px) {
    .feat-body { grid-template-columns: 1fr 1fr; gap: 2rem 4rem; }
  }

  .phone-grid { display: grid; gap: 2.5rem; align-items: center; }
  .phone-grid .facts, .phone-grid .stack, .phone-grid .reveal { margin-top: 1.5rem; }
  .phone-grid .feat-head { margin-top: 0; }
  .phone { justify-self: center; width: min(100%, 300px); }
  .phone video { width: 100%; aspect-ratio: 480 / 1044; object-fit: cover; border-radius: 34px; border: 1px solid var(--line-2); box-shadow: 0 0 0 7px #161513, 0 30px 60px -30px rgba(0, 0, 0, 0.9); background: #05080c; }
  .phone figcaption { text-align: center; margin-top: 1.5rem; }
  @media (min-width: 900px) {
    .phone-grid { grid-template-columns: 340px 1fr; gap: 5rem; }
    .phone { justify-self: start; }
  }

  /* PRIVATE AI */
  .ai { background: var(--bg-2); }
  .ai-grid { display: grid; gap: 2.5rem; align-items: center; }
  .ai .muted { max-width: 50ch; margin-top: 1rem; }
  .ai .btn { margin-top: 1.75rem; }
  .ai-shot { display: block; border: 1px solid var(--line-2); border-radius: var(--radius); overflow: hidden; transition: border-color 250ms var(--ease); }
  .ai-shot:hover { border-color: var(--gold); }
  .ai-shot img { width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; }
  @media (min-width: 900px) { .ai-grid { grid-template-columns: 1fr 1fr; gap: 4.5rem; } }

  /* MORE WORK */
  .group { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .group-name { font-family: var(--font-mono); font-weight: 400; padding-bottom: 1rem; border-bottom: 1px solid var(--line-2); }
  .row { display: grid; grid-template-columns: 84px 1fr; gap: 0.75rem 1.1rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); align-items: start; }
  .row-thumb { width: 84px; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; border: 1px solid var(--line); background: var(--card); display: grid; place-items: center; }
  .row-thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .mono-mark { font-family: var(--font-display); font-size: 1.6rem; color: var(--gold); }
  .row h4 { font-family: var(--font-display); font-weight: 400; font-size: 1.4rem; line-height: 1.15; letter-spacing: -0.01em; }
  .group-note { color: var(--ink-2); font-size: 0.95rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
  .row-thumb { position: relative; }
  .concept-stamp {
    position: absolute; top: 14px; left: -30px; width: 110px; padding: 3px 0; z-index: 1;
    transform: rotate(-45deg); text-align: center;
    background: rgba(200, 40, 40, 0.82); color: #fff;
    font-family: var(--font-mono); font-size: 0.56rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
  }
  .row-link { border-bottom: 1px solid var(--line-2); transition: color 200ms var(--ease), border-color 200ms var(--ease); }
  .row-link:hover { color: var(--gold-hi); border-color: var(--gold); }
  .row-kind { color: var(--ink-3); font-size: 0.88rem; margin-top: 0.15rem; }
  .row-desc { color: var(--ink-2); font-size: 0.95rem; margin-top: 0.5rem; max-width: 54ch; }
  .row-meta { grid-column: 2; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .row-meta .label:first-child { color: var(--ink); }
  @media (min-width: 900px) {
    .row { grid-template-columns: 132px 1fr 230px; gap: 2rem; padding: 1.6rem 0; }
    .row-thumb { width: 132px; }
    .row-meta { grid-column: auto; flex-direction: column; align-items: flex-end; text-align: right; gap: 0.5rem; padding-top: 0.35rem; }
  }

  /* ABOUT */
  .about-grid { display: grid; gap: 2rem; }
  .about .muted { margin-top: 1.1rem; max-width: 56ch; }
  .about .lead { max-width: 44ch; }
  .steps { list-style: none; padding: 0; margin-top: 2.5rem; border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 1rem; padding: 1.2rem 0; border-bottom: 1px solid var(--line); }
  .steps .label { padding-top: 0.45rem; }
  .steps h3 { font-size: 1.25rem; }
  .steps p { color: var(--ink-2); font-size: 0.95rem; margin-top: 0.3rem; max-width: 52ch; }
  @media (min-width: 900px) { .about-grid { grid-template-columns: 0.8fr 1.2fr; gap: 5rem; } }

  /* CONTACT */
  .contact { background: var(--bg-2); }
  .contact h2 { max-width: 16ch; }
  .contact .lead { margin-top: 1rem; max-width: 40ch; }
  .fineprint { margin-top: 1.75rem; font-size: 0.9rem; }
</style>
