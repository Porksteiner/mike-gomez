---
import footer from '../data/footer.json';
import settings from '../data/settings.json';
const year = new Date().getFullYear();
---
<footer class="site-foot rule">
  <div class="shell">
    <blockquote class="verse">
      <p>“{footer.verse}”</p>
      <cite class="label">{footer.verseReference}</cite>
    </blockquote>
    <div class="foot-row">
      <p class="foot-name">Mike Gomez <span class="muted">— Systems engineer, Alabama</span></p>
      <ul class="foot-links">
        <li><a href="/#work">Work</a></li>
        <li><a href="/work/falkryn/">FALKRYN case study</a></li>
        <li><a href="/work/baitiq/">BaitIQ case study</a></li>
        <li><a href="/private-ai/">Private AI</a></li>
        <li><a href="/#about">About</a></li>
        <li><a href={`mailto:${settings.email}`}>{settings.email}</a></li>
        <li><a href="https://apps.apple.com/us/app/baitiq/id6768169415" target="_blank" rel="noopener noreferrer">BaitIQ on the App Store</a></li>
      </ul>
    </div>
    <p class="label fine">© {year} Mike Gomez. Designed and built in-house. Last updated November 2026.</p>
  </div>
</footer>

<style>
  .site-foot { padding-block: clamp(3.5rem, 7vw, 5.5rem) 2.5rem; background: var(--bg-2); }
  .verse { max-width: 34ch; }
  .verse p { font-family: var(--font-display); font-style: italic; font-size: clamp(1.25rem, 1rem + 1vw, 1.7rem); line-height: 1.35; color: var(--ink); }
  .verse cite { display: block; margin-top: 1rem; font-style: normal; color: var(--gold); }
  .foot-row { margin-top: clamp(2.5rem, 5vw, 4rem); padding-top: 2rem; border-top: 1px solid var(--line); display: grid; gap: 1.5rem; }
  .foot-name { font-family: var(--font-display); font-size: 1.15rem; }
  .foot-name .muted { font-family: var(--font-sans); font-size: 0.95rem; }
  .foot-links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.75rem; }
  .foot-links a { color: var(--ink-2); font-size: 0.95rem; display: inline-block; padding: 0.35rem 0; transition: color 200ms var(--ease); }
  .foot-links a:hover { color: var(--gold-hi); }
  .fine { margin-top: 2.5rem; }
  @media (min-width: 860px) { .foot-row { grid-template-columns: auto 1fr; gap: 3rem; align-items: center; } .foot-name { white-space: nowrap; } .foot-links { justify-content: flex-end; } }
</style>
